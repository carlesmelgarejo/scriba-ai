# Copia aquest fitxer a .env.local i omple els valors

# --- AssemblyAI ---
ASSEMBLYAI_API_KEY=...

# Opcional (valors per defecte si no s'indiquen)
ASSEMBLYAI_LANGUAGE=ca
# Model de l'LLM Gateway d'AssemblyAI per redactar l'acta
ASSEMBLYAI_LLM_MODEL=claude-haiku-4-5-20251001

# --- Login (només contrasenya) ---
# Hash bcrypt en base64 (evita problemes amb els '$' als fitxers .env). Genera'l amb:
#   node -e "console.log(Buffer.from(require('bcryptjs').hashSync(process.argv[1],12)).toString('base64'))" 'LA_TEVA_CONTRASENYA'
AUTH_PASSWORD_HASH_B64=

# Secret per signar la cookie de sessió. Genera'l amb:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# --- Històric ---
# Carpeta on es desen les reunions (JSON + Markdown). En producció amb build
# standalone, apunta-la FORA de .next perquè no es perdi en cada desplegament,
# p. ex. /home/scribaai/htdocs/scribaai.elclic.net/data
# En local no cal: per defecte fa servir ./data
# SCRIBA_DATA_DIR=
